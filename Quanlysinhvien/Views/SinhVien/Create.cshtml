@model QuanLySinhVien.Models.SinhVien

@{
    ViewData["Title"] = "Thêm sinh viên";
}

<div class="form-card">

    <h1 class="form-title">
        <i class="fa-solid fa-user-plus"></i>
        Thêm sinh viên
    </h1>

    <form asp-action="Create"
          method="post"
          enctype="multipart/form-data">

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

        <!-- HỌ TÊN -->
        <div class="form-group">
            <label asp-for="HoTen"
                   class="form-label">
            </label>

            <input asp-for="HoTen"
                   class="form-control"
                   placeholder="Nhập họ và tên" />

            <span asp-validation-for="HoTen"
                  class="text-danger">
            </span>
        </div>

        <!-- EMAIL -->
        <div class="form-group">
            <label asp-for="Email"
                   class="form-label">
            </label>

            <input asp-for="Email"
                   class="form-control"
                   placeholder="example@gmail.com" />

            <span asp-validation-for="Email"
                  class="text-danger">
            </span>
        </div>

        <!-- SỐ ĐIỆN THOẠI -->
        <div class="form-group">
            <label asp-for="SoDienThoai"
                   class="form-label">
            </label>

            <input asp-for="SoDienThoai"
                   class="form-control"
                   placeholder="Nhập số điện thoại" />

            <span asp-validation-for="SoDienThoai"
                  class="text-danger">
            </span>
        </div>

        <!-- LỚP -->
        <div class="form-group">
            <label asp-for="Lop"
                   class="form-label">
            </label>

            <input asp-for="Lop"
                   class="form-control"
                   placeholder="Ví dụ: CNTT1" />

            <span asp-validation-for="Lop"
                  class="text-danger">
            </span>
        </div>

        <!-- ĐIỂM -->
        <div class="form-group">
            <label asp-for="Diem"
                   class="form-label">
            </label>

            <input asp-for="Diem"
                   type="number"
                   min="0"
                   max="10"
                   step="0.1"
                   class="form-control"
                   placeholder="0 - 10" />

            <span asp-validation-for="Diem"
                  class="text-danger">
            </span>
        </div>

        <!-- UPLOAD HÌNH ẢNH -->
        <div class="form-group">
            <label asp-for="ImageFile"
                   class="form-label">
                Hình ảnh sinh viên
            </label>

            <input asp-for="ImageFile"
                   type="file"
                   class="form-control"
                   accept=".jpg,.jpeg,.png" />

            <span asp-validation-for="ImageFile"
                  class="text-danger">
            </span>

            <small class="text-muted">
                Chỉ chấp nhận hình ảnh JPG, JPEG hoặc PNG.
            </small>
        </div>

        <!-- CÁC NÚT -->
        <div class="form-actions">

            <button type="submit"
                    class="btn btn-primary">
                <i class="fa-solid fa-save"></i>
                Lưu
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left"></i>
                Quay lại
            </a>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}