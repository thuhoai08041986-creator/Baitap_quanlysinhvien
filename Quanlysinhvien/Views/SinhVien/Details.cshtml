@model QuanLySinhVien.Models.SinhVien

@{
    ViewData["Title"] = "Chi tiết sinh viên";
}

<div class="form-card">

    <h1 class="form-title">
        <i class="fa-solid fa-address-card"></i>
        Thông tin sinh viên
    </h1>

    <!-- ============================= -->
    <!-- HÌNH ẢNH SINH VIÊN -->
    <!-- ============================= -->

    <div style="text-align:center; margin-bottom:25px;">

        @if (!string.IsNullOrEmpty(Model.HinhAnh))
        {
            <img src="@Url.Content("~/images/students/" + Model.HinhAnh)"
                 alt="@Model.HoTen"
                 width="160"
                 height="160"
                 style="
            object-fit:cover;
            border-radius:10px;
            border:3px solid #e2e8f0;
            box-shadow:0 4px 10px rgba(0,0,0,0.1);
            " />
        }
        else
        {
            <div style="
                width:160px;
                height:160px;
                margin:auto;
                display:flex;
                align-items:center;
                justify-content:center;
                background:#f1f5f9;
                border-radius:10px;
                color:#94a3b8;
                border:2px dashed #cbd5e1;
                ">
                <div>
                    <i class="fa-solid fa-user"
                       style="font-size:50px;"></i>

                    <div style="margin-top:10px;">
                        Chưa có ảnh
                    </div>
                </div>
            </div>
        }

    </div>


    <!-- ============================= -->
    <!-- THÔNG TIN SINH VIÊN -->
    <!-- ============================= -->

    <div class="detail-row">
        <strong>Mã sinh viên</strong>
        <span>@Model.Id</span>
    </div>

    <div class="detail-row">
        <strong>Họ và tên</strong>
        <span>@Model.HoTen</span>
    </div>

    <div class="detail-row">
        <strong>Email</strong>
        <span>@Model.Email</span>
    </div>

    <div class="detail-row">
        <strong>Số điện thoại</strong>
        <span>@Model.SoDienThoai</span>
    </div>

    <div class="detail-row">
        <strong>Lớp</strong>
        <span>@Model.Lop</span>
    </div>

    <div class="detail-row">
        <strong>Điểm</strong>
        <span class="score">
            @Model.Diem
        </span>
    </div>


    <!-- ============================= -->
    <!-- NÚT CHỨC NĂNG -->
    <!-- ============================= -->

    <div style="margin-top:25px;">

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">

            <i class="fa-solid fa-pen"></i>
            Sửa

        </a>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="fa-solid fa-arrow-left"></i>
            Quay lại

        </a>

    </div>

</div>