@model QuanLySinhVien.Models.SinhVien

@{
    ViewData["Title"] = "Sửa sinh viên";
}

<div class="form-card">

    <h1 class="form-title">
        <i class="fa-solid fa-user-pen"></i>
        Sửa thông tin sinh viên
    </h1>

    <form asp-action="Edit"
          method="post"
          enctype="multipart/form-data">

        <!-- ID sinh viên -->
        <input type="hidden" asp-for="Id" />

        <!-- Giữ lại tên ảnh hiện tại -->
        <input type="hidden" asp-for="HinhAnh" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>


        <!-- HỌ TÊN -->
        <div class="form-group">

            <label asp-for="HoTen"
                   class="form-label">
            </label>

            <input asp-for="HoTen"
                   class="form-control" />

            <span asp-validation-for="HoTen"
                  class="text-danger">
            </span>

        </div>


        <!-- EMAIL -->
        <div class="form-group">

            <label asp-for="Email"
                   class="form-label">
            </label>

            <input asp-for="Email"
                   class="form-control" />

            <span asp-validation-for="Email"
                  class="text-danger">
            </span>

        </div>


        <!-- SỐ ĐIỆN THOẠI -->
        <div class="form-group">

            <label asp-for="SoDienThoai"
                   class="form-label">
            </label>

            <input asp-for="SoDienThoai"
                   class="form-control" />

            <span asp-validation-for="SoDienThoai"
                  class="text-danger">
            </span>

        </div>


        <!-- LỚP -->
        <div class="form-group">

            <label asp-for="Lop"
                   class="form-label">
            </label>

            <input asp-for="Lop"
                   class="form-control" />

            <span asp-validation-for="Lop"
                  class="text-danger">
            </span>

        </div>


        <!-- ĐIỂM -->
        <div class="form-group">

            <label asp-for="Diem"
                   class="form-label">
            </label>

            <input asp-for="Diem"
                   class="form-control"
                   type="number"
                   min="0"
                   max="10"
                   step="0.1" />

            <span asp-validation-for="Diem"
                  class="text-danger">
            </span>

        </div>


        <!-- ================================= -->
        <!-- HÌNH ẢNH HIỆN TẠI -->
        <!-- ================================= -->

        <div class="form-group">

            <label class="form-label">
                Hình ảnh hiện tại
            </label>

            <div style="margin-top:10px; margin-bottom:15px;">

                @if (!string.IsNullOrEmpty(Model.HinhAnh))
                {
                    <img src="@Url.Content("~/images/students/" + Model.HinhAnh)"
                         alt="@Model.HoTen"
                         width="150"
                         height="150"
                         style="
                    object-fit:cover;
                    border-radius:10px;
                    border:2px solid #ddd;
                    " />
                }
                else
                {
                    <div style="
                        width:150px;
                        height:150px;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        background:#f1f5f9;
                        border:2px dashed #cbd5e1;
                        border-radius:10px;
                        color:#64748b;
                        ">
                        Chưa có ảnh
                    </div>
                }

            </div>

        </div>


        <!-- ================================= -->
        <!-- CHỌN ẢNH MỚI -->
        <!-- ================================= -->

        <div class="form-group">

            <label asp-for="ImageFile"
                   class="form-label">
                Chọn hình ảnh mới
            </label>

            <input asp-for="ImageFile"
                   type="file"
                   class="form-control"
                   accept=".jpg,.jpeg,.png" />

            <span asp-validation-for="ImageFile"
                  class="text-danger">
            </span>

            <small class="text-muted">
                Chỉ chấp nhận file JPG, JPEG hoặc PNG.
                Nếu không chọn ảnh mới, hệ thống sẽ giữ ảnh hiện tại.
            </small>

        </div>


        <!-- NÚT -->
        <div class="form-actions">

            <button type="submit"
                    class="btn btn-primary">

                <i class="fa-solid fa-save"></i>
                Lưu thay đổi

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="fa-solid fa-arrow-left"></i>
                Quay lại

            </a>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}